# Required when the service binds beyond localhost.
NRI_DEMO_USERNAME=reviewer
NRI_DEMO_PASSWORD=replace-with-a-demo-password
NRI_REQUIRE_AUTH=true

# Base64-encoded Codex OAuth cache. Add the real value only in Railway Secrets.
CODEX_AUTH_JSON_B64=

# Optional operational limits for the private demo.
NRI_STATE_ROOT=/data
NRI_CODEX_MODEL=
NRI_MODEL_TIMEOUT=180
NRI_RUN_WORKERS=2
NRI_MAX_QUEUED_RUNS=10
NRI_MAX_RETAINED_RUNS=50
NRI_RUN_LIMIT=60
NRI_RUN_WINDOW_SECONDS=3600
NRI_MAX_BODY_BYTES=65536
